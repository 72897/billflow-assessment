# ---------------------------------------------------------------------------
# BillFlow environment variables
# Copy to `.env.local` and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string.
#
# LEAVE BLANK for local development: BillFlow falls back to PGlite, a real
# PostgreSQL 16 engine compiled to WebAssembly that stores its data in
# `./.pgdata`. The exact same SQL migrations run in both modes, so nothing has
# to be installed to get started.
#
# REQUIRED in production. Any Postgres provider works (Supabase, Neon, Railway,
# RDS...).
#
# Supabase: use the *session pooler* string from Connect → Session pooler. It
# resolves over IPv4, which the direct `db.<ref>.supabase.co` host does not:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# `?sslmode=require` is accepted but unnecessary — the driver turns TLS on by
# itself for hosted providers, and verifies against the provider's chain rather
# than Node's built-in roots.
DATABASE_URL=

# --- Session / crypto -------------------------------------------------------
# 32+ random bytes used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Application ------------------------------------------------------------
# Public origin used to build shareable public invoice links and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional) -------------------------------------------------------
# Without RESEND_API_KEY, BillFlow uses its built-in "outbox" transport: every
# message is written to ./.mail/*.html and logged to the server console, so the
# send + reminder flows stay fully demonstrable with no third-party account.
RESEND_API_KEY=
EMAIL_FROM=BillFlow <invoices@billflow.app>

# --- Demo seed account ------------------------------------------------------
# Used by `npm run db:seed`.
SEED_DEMO_EMAIL=demo@billflow.app
SEED_DEMO_PASSWORD=Billflow@123
