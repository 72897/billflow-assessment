# ---------------------------------------------------------------------------
# BillFlow environment variables
# Copy to `.env.local` and fill in. Never commit real values.
# ---------------------------------------------------------------------------

# --- Database ---------------------------------------------------------------
# PostgreSQL connection string.
#
# LEAVE BLANK for local development: BillFlow falls back to PGlite, a real
# PostgreSQL 16 engine compiled to WebAssembly that stores its data in
# `./.pgdata`. The exact same SQL migrations run in both modes, so nothing has
# to be installed to get started.
#
# REQUIRED in production. Any Postgres provider works (Supabase, Neon, Railway,
# RDS...).
#
# Supabase: use the *session pooler* string from Connect → Session pooler. It
# resolves over IPv4, which the direct `db.<ref>.supabase.co` host does not:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
#
# `?sslmode=require` is accepted but unnecessary — the driver turns TLS on by
# itself for hosted providers, and verifies against the provider's chain rather
# than Node's built-in roots.
DATABASE_URL=

# --- Session / crypto -------------------------------------------------------
# 32+ random bytes used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Application ------------------------------------------------------------
# Public origin used to build shareable public invoice links and email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Email (optional) -------------------------------------------------------
# Three transports, tried in this order. With none of them configured BillFlow
# uses its built-in "outbox": every message is written to ./.mail/*.html and
# logged to the server console, so the send + reminder flows stay fully
# demonstrable with no third-party account.
#
# 1. SMTP — the one that reaches *any* recipient, so this is the recommended
#    setup. `EMAIL` / `EMAIL_PASSWORD` are accepted as aliases of the two
#    SMTP_* names below.
#
#    With Gmail the password must be a 16-character app password (Google
#    account → Security → 2-Step Verification → App passwords); the account
#    password is always refused. Spaces in it are cosmetic and are stripped.
#
#    SMTP_HOST defaults to smtp.gmail.com and SMTP_PORT to 465 (implicit TLS).
#    Port 587 starts in plaintext and upgrades via STARTTLS — set
#    SMTP_SECURE=false with it.
SMTP_USER=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# SMTP_SECURE=false

# 2. Resend — used when no SMTP mailbox is set. Note that an account without a
#    verified sending domain may only deliver to the address that owns it;
#    BillFlow treats that refusal as permanent and captures the message to the
#    outbox instead of pretending a retry might help.
RESEND_API_KEY=

# The From header. When SMTP is the transport the authenticated mailbox always
# wins (servers reject or silently rewrite an address you have not signed in
# as), so only the display name in front of the angle brackets is used.
EMAIL_FROM=BillFlow <invoices@billflow.app>

# --- Demo seed account ------------------------------------------------------
# Used by `npm run db:seed`.
SEED_DEMO_EMAIL=demo@billflow.app
SEED_DEMO_PASSWORD=Billflow@123
